                                   "Modules\\BerkasKlaimSupportingDocument\\":  "Modules/BerkasKlaimSupportingDocument/app/",
                                   "Modules\\BerkasKlaimSupportingDocument\\Database\\Factories\\":  "Modules/BerkasKlaimSupportingDocument/database/factories/",

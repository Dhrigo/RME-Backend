{
    "$schema":  "https://getcomposer.org/schema.json",
    "name":  "dhrigos/simgos-backend",
    "type":  "project",
    "description":  "Modular monolith backend, one Laravel module per source submodule.",
    "keywords":  [
                     "laravel",
                     "framework"
                 ],
    "license":  "MIT",
    "authors":  [
                    {
                        "name":  "Deva Indrayana Rahmat",
                        "email":  "dhrigos@gmail.com"
                    }
                ],
    "require":  {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.1",
        "dcarbone/php-fhir-generated": "^4.1",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "laravolt/indonesia": "^0.41.0",
        "nullpunkt/lz-string-php": "dev-master",
        "nwidart/laravel-modules": "^13.0",
        "spatie/laravel-permission": "^8.3"
    },
    "require-dev":  {
                        "brianium/paratest":  "^7.20",
                        "fakerphp/faker":  "^1.23",
                        "laravel/pail":  "^1.2.5",
                        "laravel/pao":  "^1.0.6",
                        "laravel/pint":  "^1.27",
                        "mockery/mockery":  "^1.6",
                        "nunomaduro/collision":  "^8.6",
                        "phpunit/phpunit":  "^12.5.12"
                    },

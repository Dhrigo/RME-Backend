    "autoload-dev":  {
                         "psr-4":  {
                                       "Tests\\":  "tests/",
                                       "Modules\\PenjaminRSAttendingPhysician\\Tests\\":  "Modules/PenjaminRSAttendingPhysician/tests/",
                                       "Modules\\PenjaminRSClaimDriver\\Tests\\":  "Modules/PenjaminRSClaimDriver/tests/",
                                       "Modules\\BerkasKlaimClaimFile\\Tests\\":  "Modules/BerkasKlaimClaimFile/tests/",
                                       "Modules\\BerkasKlaimSupportingDocument\\Tests\\":  "Modules/BerkasKlaimSupportingDocument/tests/",
                                       "Modules\\BerkasKlaimClaimCompleteness\\Tests\\":  "Modules/BerkasKlaimClaimCompleteness/tests/",
                                       "Modules\\BerkasKlaimClaimCompletenessComment\\Tests\\":  "Modules/BerkasKlaimClaimCompletenessComment/tests/",
                                       "Modules\\PembatalanFinalResult\\Tests\\":  "Modules/PembatalanFinalResult/tests/",
                                       "Modules\\PembatalanDocumentCancellation\\Tests\\":  "Modules/PembatalanDocumentCancellation/tests/",
                                       "Modules\\PembatalanMedicalRecordCancellation\\Tests\\":  "Modules/PembatalanMedicalRecordCancellation/tests/",
                                       "Modules\\PembatalanReturnCancellation\\Tests\\":  "Modules/PembatalanReturnCancellation/tests/"
                                   }
                     },
    "scripts":  {
                    "setup":  [
                                  "composer install",
                                  "@php -r \"file_exists(\u0027.env\u0027) || copy(\u0027.env.example\u0027, \u0027.env\u0027);\"",
                                  "@php artisan key:generate",
                                  "@php artisan migrate --force"
                              ],
                    "dev":  [
                                "Composer\\Config::disableProcessTimeout",
                                "@php artisan serve"
                            ],
                    "test":  [
                                 "@php artisan config:clear --ansi @no_additional_args",
                                 "@php artisan test --parallel"
                             ],
                    "post-autoload-dump":  [
                                               "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
                                               "@php artisan package:discover --ansi",
                                               "@php artisan module:manifest-cache --ansi"
                                           ],
                    "post-update-cmd":  [
                                            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
                                        ],
                    "post-root-package-install":  [
                                                      "@php -r \"file_exists(\u0027.env\u0027) || copy(\u0027.env.example\u0027, \u0027.env\u0027);\""
                                                  ],
                    "post-create-project-cmd":  [
                                                    "@php artisan key:generate --ansi",
                                                    "@php -r \"file_exists(\u0027database/database.sqlite\u0027) || touch(\u0027database/database.sqlite\u0027);\"",
                                                    "@php artisan migrate --graceful --ansi"
                                                ],
                    "pre-package-uninstall":  [
                                                  "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
                                              ]
                },
    "extra":  {
                  "laravel":  {
                                  "dont-discover":  [
                                                        "nwidart/laravel-modules"
                                                    ]
                              },
                  "merge-plugin":  {
                                       "include":  [
                                                       "Modules/*/composer.json"
                                                   ]
                                   }
              },
    "config":  {
                   "optimize-autoloader":  true,
                   "preferred-install":  "dist",
                   "sort-packages":  true,
                   "allow-plugins":  {
                                         "pestphp/pest-plugin":  true,
                                         "php-http/discovery":  true,
                                         "wikimedia/composer-merge-plugin":  true
                                     }
               },
    "minimum-stability":  "stable",
    "prefer-stable":  true
}
